// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 0, // Gaps handled by per-module padding/margin in style.css
    // Choose the order of the modules
    "modules-left": [
        // ext-workspace-v1 protocol. hyprland/workspaces click-to-switch is broken:
        // it sends legacy "dispatch workspace N" IPC, which Hyprland's Lua config rejects.
        "ext/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "systemd-failed-units",
        "privacy",
        "mpris",
        "idle_inhibitor",
        "wireplumber",
        "network",
        "custom/wg-netns",
        "custom/routes",
        "power-profiles-daemon",
        "cpu",
        "memory",
        "temperature",
        "backlight",
        "custom/numlock",
        "custom/capslock",
        "battery",
        "clock",
        "tray",
        "custom/power"
    ],
    // Shows the active submap (e.g. "resize"), hidden otherwise. Click to leave it.
    "hyprland/submap": {
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.submap(\"reset\")'"
    },
    "hyprland/window": {
        "separate-outputs": true // Each bar shows the focused window on its own monitor
    },
    "ext/workspaces": {
        "on-click": "activate",
        "sort-by-id": true,
        "format": "{name} {icon}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },
    // Lock indicators that only show while on. Polls the keyboard LEDs instead of using
    // keyboard-state, which reads them once on key release and can get stuck on a stale
    // state when Hyprland hasn't updated the LED yet. Custom modules hide on empty output.
    "custom/numlock": {
        "exec": "grep -qx 1 /sys/class/leds/*::numlock/brightness 2>/dev/null && echo Num",
        "interval": 1,
        "format": "{} ",
        "tooltip": false
    },
    "custom/capslock": {
        "exec": "grep -qx 1 /sys/class/leds/*::capslock/brightness 2>/dev/null && echo Caps",
        "interval": 1,
        "format": "{} ",
        "tooltip": false
    },
    // Count of failed system + user units, hidden when none. Click to list them.
    "systemd-failed-units": {
        "format": "{nr_failed} failed ",
        "on-click": "kitty --hold sh -c 'systemctl --failed; systemctl --user --failed'"
    },
    // Shows only while the screen is shared or a mic is recording (PipeWire streams)
    "privacy": {
        "icon-size": 16
    },
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "dynamic-len": 40,
        "status-icons": {
            "playing": "",
            "paused": ""
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "iso8601": true, // Monday first, ISO week numbers
            "weeks-pos": "left",
            "format": {
                "today": "<span color='#88c0d0'><b><u>{}</u></b></span>", // Nord frost
                "weeks": "<span color='#616e88'>{}</span>" // dim week numbers
            }
        },
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // First existing CPU sensor: AMD k10temp (Tctl), then Intel coretemp (package).
        // Without this it reads thermal_zone0, which can be the wifi card.
        "hwmon-path-abs": [
            "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
            "/sys/devices/platform/coretemp.0/hwmon"
        ],
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "events": {
            "on-discharging-warning": "notify-send 'Battery low' 'Below 30%'",
            "on-discharging-critical": "notify-send -u critical 'Battery critical' 'Below 15%, plug in now'"
        },
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    // WireGuard in the netns setup (wireguard.com/netns): shows while namespace "physical" exists,
    // warns when wg0 is missing, down or not the default route. Hidden otherwise.
    "custom/wg-netns": {
        "exec": "$HOME/.local/bin/waybar-wg-netns physical wg0",
        "return-type": "json",
        "interval": 5
    },
    // Hover to list every interface with IPv4 routes (all routing tables), skipping
    // container/VM bridges. Default routes show their gateway and metric.
    "custom/routes": {
        "exec": "ip -j -4 route show table all | jq -c '[.[] | select(.table != \"local\" and (.type // \"unicast\") == \"unicast\" and (.flags | index(\"linkdown\") | not) and (.dev | test(\"^(lo|docker|br-|veth|virbr|vmnet)\") | not))] | group_by(.dev) | map(.[0].dev + \": \" + ([.[] | .dst + (if .gateway then \" via \" + .gateway else \"\" end) + (if .metric then \" (metric \\(.metric))\" else \"\" end)] | join(\", \"))) | {text: \"\uf0e8\", tooltip: join(\"\\n\")}'",
        "return-type": "json",
        "interval": 10
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "wireplumber": {
        "format": "{volume}% {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": ["", "", ""],
        "tooltip-format": "{node_name}\nMic: {source_desc}",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"lock": "hyprlock",
			"shutdown": "systemctl poweroff", // plain `shutdown` waits a minute
			"reboot": "systemctl reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
