#!/bin/sh
# Waybar status for WireGuard in the network namespace setup from https://www.wireguard.com/netns/:
# the physical interfaces live in namespace NETNS and only IFACE is left in the init namespace.
# Usage: waybar-wg-netns [netns] [iface]   (defaults: physical wg0)
# Prints nothing (module hidden) unless that setup is in use, so it's safe on every machine.
#
# Unprivileged on purpose: reads /run/netns and the init namespace's links and routes only.
# The handshake (`wg show` needs CAP_NET_ADMIN) and the uplink inside the namespace
# (`ip netns exec` needs CAP_SYS_ADMIN) need root, so they aren't shown.

NETNS=${1:-physical}
IFACE=${2:-wg0}

# `ip netns add` creates this file; it stays until `ip netns delete`
[ -e "/run/netns/$NETNS" ] || exit 0

# A same-named namespace used for something else: no tunnel here and the hardware NICs
# (the only links with a device/ in sysfs) were never moved out of the init namespace
if [ ! -e "/sys/class/net/$IFACE" ]; then
    for dev in /sys/class/net/*/device; do
        [ -e "$dev" ] && exit 0
    done
fi

# Missing interface → empty arrays, reported as down below
link=$(ip -j -s link show dev "$IFACE" 2>/dev/null) || link='[]'
addr=$(ip -j addr show dev "$IFACE" 2>/dev/null) || addr='[]'
routes=$(ip -j route show default table all 2>/dev/null) || routes='[]'

jq -nc --arg ns "$NETNS" --arg if "$IFACE" \
    --argjson link "$link" --argjson addr "$addr" --argjson routes "$routes" '
    def human: if . < 1024 then "\(.) B"
        else [., 0] | until(.[0] < 1024 or .[1] == 4; [.[0] / 1024, .[1] + 1])
            | "\(.[0] * 10 | round / 10) \(["B", "KiB", "MiB", "GiB", "TiB"][.[1]])" end;
    ($link[0] // null) as $l
    | ([$addr[0].addr_info[]? | "\(.local)/\(.prefixlen)"]) as $ips
    | ([$routes[] | select(.dev == $if)] | length > 0) as $default
    | (if $l == null then "\($if) does not exist"
        elif ($l.flags | index("UP") | not) then "\($if) is down"
        elif ($default | not) then "no default route via \($if)"
        else null end) as $problem
    | "Physical interfaces are isolated in namespace \"\($ns)\"" as $isolated
    | if $problem then {
        text: "VPN down ⚠",
        class: "down",
        tooltip: "WireGuard netns: \($problem)\n\($isolated),\nso this namespace has no way out (fails closed)"
      } else {
        text: "VPN up ",
        class: "up",
        tooltip: ([
            "WireGuard netns: all traffic goes through \($if)",
            "Address: \(if $ips == [] then "none" else $ips | join(", ") end)",
            $isolated,
            "Received \($l.stats64.rx.bytes | human), sent \($l.stats64.tx.bytes | human)",
            "Handshake and uplink need root, not shown"
          ] | join("\n"))
      } end'
